# --- Secrets and credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets/

# --- Data (regenerated by the pipeline; provenance kept in docs) ---
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.csv.gz
*.parquet

# --- Model artefacts and generated outputs ---
models/
outputs/*
!outputs/.gitkeep
*.pkl
*.joblib
*.lgb
*.onnx

# --- Python environments and caches ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- Notebooks and editors ---
.ipynb_checkpoints/
.vscode/
.idea/

# --- macOS ---
.DS_Store

# Frozen archives of earlier results (kept locally, never uploaded)
outputs_archive/
